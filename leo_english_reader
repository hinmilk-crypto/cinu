const app = document.getElementById('app');
let currentUtterance = null;

function speak(text, onEnd){
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  u.rate = 0.88;
  u.pitch = 1.05;
  if(onEnd) u.onend = onEnd;
  currentUtterance = u;
  window.speechSynthesis.speak(u);
}

function renderMenu(){
  window.speechSynthesis.cancel();
  let html = '';
  UNITS.forEach(u=>{
    const dayNums = Object.keys(u.days).map(Number).sort((a,b)=>a-b);
    html += `<div class="unit-card">
      <div class="unit-head">
        <div>
          <p class="unit-title">${u.title}</p>
          <p class="unit-sub">${u.sub}</p>
        </div>
        <button class="full-btn" onclick="renderFull(${u.num})">📖 전체 읽기</button>
      </div>
      <div class="day-grid">
        ${dayNums.map(d=>`<button class="day-btn c${u.color}" onclick="renderDay(${u.num},${d})">Day ${d}</button>`).join('')}
      </div>
    </div>`;
  });
  app.innerHTML = html;
}

function renderDay(unitNum, dayNum){
  window.speechSynthesis.cancel();
  const unit = UNITS.find(u=>u.num===unitNum);
  const sentences = unit.days[dayNum];
  let html = `
    <div class="top-bar">
      <button class="back-btn" onclick="renderMenu()">◀ 목록</button>
      <h2 class="view-title">${unit.title} · Day ${dayNum}</h2>
    </div>
    <p class="hint">🔊 문장을 누르면 발음이 나와요 · 한 번 더 누르면 뜻이 보여요</p>
  `;
  sentences.forEach((pair, i)=>{
    html += `<div class="sentence-card" id="s${i}" onclick="handleSentenceClick(${i})">
      <div class="sentence-row">
        <div class="speaker">🔊</div>
        <div class="en-text">${pair[0]}</div>
      </div>
      <div class="kr-text" id="k${i}">${pair[1]}</div>
    </div>`;
  });
  app.innerHTML = html;
  window._daySentences = sentences;
  window._dayState = {}; // tracks whether translation shown per index
}

function handleSentenceClick(i){
  const card = document.getElementById('s'+i);
  const kr = document.getElementById('k'+i);
  const text = window._daySentences[i][0];
  const alreadyShown = kr.classList.contains('show');

  document.querySelectorAll('.sentence-card').forEach(c=>c.classList.remove('playing'));
  card.classList.add('playing');

  if(!alreadyShown){
    speak(text);
    kr.classList.add('show');
  } else {
    speak(text);
  }
}

function renderFull(unitNum){
  window.speechSynthesis.cancel();
  const unit = UNITS.find(u=>u.num===unitNum);
  let html = `
    <div class="top-bar">
      <button class="back-btn" onclick="renderMenu()">◀ 목록</button>
      <h2 class="view-title">${unit.title} · 전체 지문</h2>
    </div>
    <p class="hint">▶️ 버튼을 누르면 그 문단을 들을 수 있어요</p>
  `;
  unit.full.forEach((para, i)=>{
    html += `<div class="para-card">
      <div class="para-top">
        <button class="play-btn" onclick="playPara(this, ${unitNum}, ${i})">▶</button>
        <strong>문단 ${i+1}</strong>
      </div>
      <div class="para-text">${para}</div>
    </div>`;
  });
  app.innerHTML = html;
}

function playPara(btn, unitNum, idx){
  const unit = UNITS.find(u=>u.num===unitNum);
  const text = unit.full[idx];
  document.querySelectorAll('.play-btn').forEach(b=>b.innerHTML='▶');
  btn.innerHTML = '⏸';
  speak(text, ()=>{ btn.innerHTML='▶'; });
}

renderMenu();
</script>
